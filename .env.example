# Shopify Storefront API (headless merch store).
#
# Store admin: https://admin.shopify.com/store/chaiwallahs-qbr1901v
#
# PUBLIC_SHOPIFY_STORE_DOMAIN is the store's *.myshopify.com domain (not the
# eventual chaiwallahs.co.uk/store custom domain — that's just where visitors
# land, the API always talks to the myshopify.com one).
PUBLIC_SHOPIFY_STORE_DOMAIN=chaiwallahs-qbr1901v.myshopify.com

# Settings -> Apps and sales channels -> Develop apps -> (create an app) ->
# Configuration -> Storefront API -> enable the unauthenticated_read/write
# scopes -> Install app -> API credentials tab -> Storefront API access token.
# Safe to expose client-side: this token only ever grants the unauthenticated
# read + cart scopes, never admin access, which is exactly why it's prefixed
# PUBLIC_ (Astro inlines PUBLIC_ vars into client-side JS).
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
