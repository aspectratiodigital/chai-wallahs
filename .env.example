# Copy this file to .env (which is gitignored) and fill in real values
# for local builds/dev. Netlify needs the same two variables added under
# Site settings -> Environment variables for deploys to pick them up.

# Spotify Client Credentials (build-time only, never sent to the browser).
# Create a free app at https://developer.spotify.com/dashboard to get these -
# no approval needed, this only reads public catalog data.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
