---
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import sharp from "sharp";

import FacebookIcon from "../../assets/images/social/facebook.png";
import InstagramIcon from "../../assets/images/social/instagram.png";
import YoutubeIcon from "../../assets/images/social/youtube.png";
import TiktokIcon from "../../assets/images/social/tiktok.svg";
import XIcon from "../../assets/images/social/x.svg";

const PLATFORM_ICON: Record<string, ImageMetadata> = {
  facebook: FacebookIcon,
  instagram: InstagramIcon,
  youtube: YoutubeIcon,
  tiktok: TiktokIcon,
  twitter: XIcon,
};

const PLATFORM_LABEL: Record<string, string> = {
  facebook: "Facebook",
  instagram: "Instagram",
  youtube: "YouTube",
  tiktok: "TikTok",
  twitter: "X",
};

export async function getStaticPaths() {
  const artists = await getCollection("artists");
  return artists.map((artist) => ({
    params: { slug: artist.id },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const { name, genres, image, socials } = artist.data;
const { Content } = await render(artist);
const hasBody = (artist.body ?? "").trim().length > 0;

// The name runs as a single line of vertical text straddling the photo's
// right edge, sized in JS (below) to exactly fill the real run length
// between TOP_OFFSET below the photo's top and GENRE_CLEARANCE above the
// genre text (see the script below) - short names like "Birty" hit
// NAME_MAX_PX (the ceiling), longer ones scale down just enough to fit.
// This SSR value is only the pre-JS fallback (same budget heuristic as
// before), refined precisely on load. All the pixel values on this page
// (frame size, offsets, icon/text sizes) are kept in the same proportion
// to each other as they're resized together.
const NAME_MAX_PX = 88.32; // the hard ceiling, per short names like "Birty"
const NAME_RUN_BUDGET_PX = 920;
const NAME_MIN_PX = 14;
const rawNameFontPx = NAME_RUN_BUDGET_PX / Math.max(name.length, 1);
const nameFontMaxPx = Math.min(NAME_MAX_PX, Math.max(NAME_MIN_PX, rawNameFontPx));

// Pick a name colour that reads clearly against whatever photo is behind
// it: black on a mostly-light photo, white on a mostly-dark one, and gold
// when the photo's tones are too mixed/contrasty for either to reliably
// read well against all of it.
let nameColor = "var(--chai-gold)";
try {
  const filePath = path.join(process.cwd(), "public", image.replace(/^\//, ""));
  const { channels } = await sharp(filePath).stats();
  const [r, g, b] = channels;
  const meanLuma = 0.299 * r.mean + 0.587 * g.mean + 0.114 * b.mean;
  const avgStdev = (r.stdev + g.stdev + b.stdev) / 3;
  if (avgStdev > 72) {
    nameColor = "var(--chai-gold)";
  } else if (meanLuma > 150) {
    nameColor = "var(--stage-black)";
  } else {
    nameColor = "var(--off-white)";
  }
} catch {
  // Fall back to gold above if the file can't be read.
}
---

<BaseLayout title={name} description={genres.length ? `${name} — ${genres.join(", ")}` : name}>
  <div class="artist-page">
    <div class="wrap back-row">
      <a class="eyebrow back-link" href="/artists/">&lt; Back to Artists</a>
    </div>

    <div class="wrap photo-wrap">
      <div class="artist-photo-frame">
        <Image src={image} alt={name} width={690} height={863} class="artist-photo" />

        <div class="artist-name-strip" id="artist-name-strip">
          <h1
            class="artist-name"
            id="artist-name"
            data-max-font-px={NAME_MAX_PX}
            style={`font-size: ${nameFontMaxPx}px; color: ${nameColor};`}
          >
            {name}
          </h1>
        </div>

        {
          socials.length > 0 && (
            <div class="artist-socials-strip">
              {socials.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${name} on ${PLATFORM_LABEL[s.platform] ?? s.platform}`}
                  data-platform={s.platform}
                >
                  {PLATFORM_ICON[s.platform] ? (
                    <span
                      class="social-icon"
                      style={`-webkit-mask-image:url("${PLATFORM_ICON[s.platform].src}"); mask-image:url("${PLATFORM_ICON[s.platform].src}");`}
                    />
                  ) : (
                    <span class="social-fallback">{PLATFORM_LABEL[s.platform] ?? s.platform}</span>
                  )}
                </a>
              ))}
            </div>
          )
        }

        {genres.length > 0 && <p class="artist-genre-strip">{genres.join(", ")}</p>}
      </div>
    </div>

    {
      hasBody && (
        <div class="wrap artist-about-wrap">
          <div class="artist-about-body">
            <Content />
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .artist-page {
    background: var(--stage-black);
    color: var(--off-white);
    padding-bottom: var(--space-6);
    overflow-x: clip;
  }

  .back-row {
    padding-top: var(--space-3);
  }

  .back-link {
    display: inline-block;
    color: var(--chai-gold);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .photo-wrap {
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    display: flex;
    justify-content: center;
  }

  .artist-photo-frame {
    position: relative;
    width: 100%;
    max-width: 644px;
  }

  .artist-photo-frame :global(.artist-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* Name runs vertically along the photo's right edge, the edge itself
     bisecting the text horizontally - half over the image, half hanging
     into the black background. Vertically it runs from just below the
     photo's top to just above the genre text (see TOP_OFFSET/
     GENRE_CLEARANCE in the script below); top here is only the pre-JS
     fallback, refined precisely by that script. */
  .artist-name-strip {
    position: absolute;
    top: 15px;
    right: 0;
    writing-mode: vertical-rl;
    translate: 50% 0;
    pointer-events: none;
  }

  .artist-name {
    margin: 0;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Social icons stack along the photo's left edge toward the bottom, the
     edge bisecting each icon the same way. Centering happens per-icon
     (not on the shared strip) so YouTube's wider box doesn't throw off
     where the narrower square icons land on that edge. */
  .artist-socials-strip {
    position: absolute;
    left: 0;
    bottom: 14%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.84rem;
  }

  .artist-socials-strip a {
    display: block;
    translate: -50% 0;
    opacity: 0.9;
    transition: opacity 0.15s ease, background-color 0.15s ease;
  }

  .artist-socials-strip a:hover {
    opacity: 1;
  }

  .social-icon {
    display: block;
    width: 63px;
    height: 63px;
    background-color: var(--off-white);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    transition: background-color 0.15s ease;
  }

  /* The source icon glyphs don't share the same amount of internal padding
     (Instagram's fills almost the whole canvas, YouTube's leaves a lot of
     margin), so at a shared mask-size they don't read as the same size.
     Facebook is the visual reference point; Instagram is scaled down to
     match it. YouTube's badge is naturally wide rather than square, so
     instead of overscaling it inside a square box (which just clips the
     sides), its box is widened and left at mask-size: contain so the
     whole glyph shows at a comparable visual size with nothing cut off. */
  .artist-socials-strip a[data-platform="instagram"] .social-icon {
    -webkit-mask-size: 78%;
    mask-size: 78%;
  }

  .artist-socials-strip a[data-platform="youtube"] .social-icon {
    width: 114px;
  }

  .artist-socials-strip a:hover .social-icon {
    background-color: var(--chai-gold);
  }

  .social-fallback {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--off-white);
  }

  /* Genre sits at the bottom-right corner, its trailing edge a fixed 16px
     in from the photo's right edge, and the photo's bottom edge bisecting
     it vertically through its centre - matching how the name and socials
     straddle their own edges. */
  .artist-genre-strip {
    position: absolute;
    bottom: 0;
    right: 13px;
    translate: 0 50%;
    margin: 0;
    font-style: italic;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--off-white);
    white-space: nowrap;
    font-size: clamp(1.07rem, 3.1vw, 1.64rem);
  }

  .artist-about-wrap {
    max-width: 1120px;
    text-align: center;
  }

  .artist-about-body :global(p) {
    opacity: 0.85;
    line-height: 1.7;
    font-size: 1.35rem;
    margin-bottom: 1em;
  }

  @media (max-width: 560px) {
    .artist-photo-frame {
      max-width: 437px;
    }

    .artist-genre-strip {
      font-size: 1.15rem;
      right: 12px;
    }

    .social-icon {
      width: 63px;
      height: 63px;
    }

    .artist-socials-strip a[data-platform="youtube"] .social-icon {
      width: 114px;
    }

    .artist-about-body :global(p) {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  // Position the vertical name run to span exactly from TOP_OFFSET below
  // the photo's top to GENRE_CLEARANCE above the genre text, then size
  // the name to fill that real (viewport-dependent) run length as
  // closely as possible -
  // capped at NAME_MAX_PX, so short names like "Birty" sit at that ceiling
  // and longer names are only shrunk as much as they actually need to be.
  function layoutArtistName() {
    const frame = document.querySelector<HTMLElement>(".artist-photo-frame");
    const strip = document.querySelector<HTMLElement>("#artist-name-strip");
    const nameEl = document.querySelector<HTMLElement>("#artist-name");
    const genre = document.querySelector<HTMLElement>(".artist-genre-strip");
    if (!frame || !strip || !nameEl) return;

    const TOP_OFFSET = 15;
    const GENRE_CLEARANCE = 31;
    const FALLBACK_BOTTOM = 68;

    const frameRect = frame.getBoundingClientRect();
    let bottomOffset = FALLBACK_BOTTOM;
    if (genre) {
      const genreRect = genre.getBoundingClientRect();
      bottomOffset = frameRect.bottom - genreRect.top + GENRE_CLEARANCE;
    }

    // Position where the run starts. Its length is computed arithmetically
    // below rather than read back from the strip's own box: under
    // writing-mode: vertical-rl the block/inline axes swap, so an abspos
    // element with only top+bottom set (no explicit height) doesn't
    // stretch to fill that span the way it would in horizontal writing
    // mode - its auto size shrink-fits content instead, so measuring it
    // directly would just measure the text, not the space available.
    strip.style.top = `${TOP_OFFSET}px`;
    const availableLength = frameRect.height - TOP_OFFSET - bottomOffset;

    const maxFontPx = parseFloat(nameEl.dataset.maxFontPx || "88.32");
    nameEl.style.fontSize = `${maxFontPx}px`;

    const naturalLength = nameEl.getBoundingClientRect().height;
    const scale = naturalLength > 0 ? Math.min(1, availableLength / naturalLength) : 1;
    nameEl.style.fontSize = `${Math.max(0, maxFontPx * scale)}px`;
  }

  layoutArtistName();
  window.addEventListener("resize", layoutArtistName);
  document.fonts?.ready?.then(layoutArtistName);
</script>
