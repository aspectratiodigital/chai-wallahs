---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

import FacebookIcon from "../../assets/images/social/facebook.png";
import InstagramIcon from "../../assets/images/social/instagram.png";
import YoutubeIcon from "../../assets/images/social/youtube.png";
import TiktokIcon from "../../assets/images/social/tiktok.svg";
import XIcon from "../../assets/images/social/x.svg";

const PLATFORM_ICON: Record<string, ImageMetadata> = {
  facebook: FacebookIcon,
  instagram: InstagramIcon,
  youtube: YoutubeIcon,
  tiktok: TiktokIcon,
  twitter: XIcon,
};

const PLATFORM_LABEL: Record<string, string> = {
  facebook: "Facebook",
  instagram: "Instagram",
  youtube: "YouTube",
  tiktok: "TikTok",
  twitter: "X",
};

export async function getStaticPaths() {
  const artists = await getCollection("artists");
  return artists.map((artist) => ({
    params: { slug: artist.id },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const { name, genres, image, socials } = artist.data;
const { Content } = await render(artist);
const hasBody = (artist.body ?? "").trim().length > 0;
---

<BaseLayout title={name} description={genres.length ? `${name} — ${genres.join(", ")}` : name}>
  <div class="artist-page">
    <div class="wrap back-row">
      <a class="eyebrow back-link" href="/artists/">&lt; Back to Artists</a>
    </div>

    <div class="artist-photo-frame">
      <Image src={image} alt={name} width={1400} height={900} class="artist-photo" />
    </div>

    <div class="wrap artist-centered">
      {
        socials.length > 0 && (
          <div class="artist-socials">
            {socials.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${name} on ${PLATFORM_LABEL[s.platform] ?? s.platform}`}
              >
                {PLATFORM_ICON[s.platform] ? (
                  <span
                    class="social-icon"
                    style={`-webkit-mask-image:url("${PLATFORM_ICON[s.platform].src}"); mask-image:url("${PLATFORM_ICON[s.platform].src}");`}
                  />
                ) : (
                  <span class="social-fallback">{PLATFORM_LABEL[s.platform] ?? s.platform}</span>
                )}
              </a>
            ))}
          </div>
        )
      }

      {genres.length > 0 && <p class="artist-genre">{genres.join(", ")}</p>}

      <h1 class="artist-name">{name}</h1>

      {
        hasBody && (
          <div class="artist-about-body">
            <Content />
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .artist-page {
    background: var(--stage-black);
    color: var(--off-white);
    padding-bottom: var(--space-6);
  }

  .back-row {
    padding-top: var(--space-3);
  }

  .back-link {
    display: inline-block;
    color: var(--chai-gold);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .artist-photo-frame {
    width: 100%;
    max-height: 70vh;
    overflow: hidden;
    margin-top: var(--space-3);
  }

  .artist-photo-frame :global(.artist-photo) {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 70vh;
    object-fit: contain;
    margin: 0 auto;
  }

  .artist-centered {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--space-4);
  }

  .artist-socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .artist-socials a {
    display: block;
    opacity: 0.85;
    transition: opacity 0.15s ease, background-color 0.15s ease;
  }

  .artist-socials a:hover {
    opacity: 1;
  }

  .social-icon {
    display: block;
    width: 32px;
    height: 32px;
    background-color: var(--off-white);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    transition: background-color 0.15s ease;
  }

  .artist-socials a:hover .social-icon {
    background-color: var(--chai-gold);
  }

  .social-fallback {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--off-white);
  }

  .artist-genre {
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--off-white);
    opacity: 0.85;
    font-size: 1rem;
    margin-bottom: var(--space-1);
  }

  .artist-name {
    color: var(--off-white);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .artist-about-body {
    max-width: 700px;
  }

  .artist-about-body :global(p) {
    opacity: 0.85;
    line-height: 1.7;
    margin-bottom: 1em;
  }

  @media (max-width: 700px) {
    .artist-photo-frame {
      max-height: 50vh;
    }

    .artist-photo-frame :global(.artist-photo) {
      max-height: 50vh;
    }
  }
</style>
