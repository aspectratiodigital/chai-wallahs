---
// Every artist page routes through here. Most use the current design
// (ArtistProfile); the artists listed in CLASSIC_DESIGN keep the original
// design (ArtistPageClassic) so the two can be compared side by side.
import { getCollection } from "astro:content";
import ArtistProfile from "../../components/ArtistProfile.astro";
import ArtistPageClassic from "../../components/ArtistPageClassic.astro";

const CLASSIC_DESIGN = new Set(["amy-true"]);

export async function getStaticPaths() {
  const artists = await getCollection("artists");
  return artists.map((artist) => ({
    params: { slug: artist.id },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const classic = CLASSIC_DESIGN.has(artist.id);
---

{classic ? <ArtistPageClassic artist={artist} /> : <ArtistProfile artist={artist} />}
