---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

import FacebookIcon from "../../assets/images/social/facebook.png";
import InstagramIcon from "../../assets/images/social/instagram.png";
import YoutubeIcon from "../../assets/images/social/youtube.png";
import TiktokIcon from "../../assets/images/social/tiktok.svg";
import XIcon from "../../assets/images/social/x.svg";

const PLATFORM_ICON: Record<string, ImageMetadata> = {
  facebook: FacebookIcon,
  instagram: InstagramIcon,
  youtube: YoutubeIcon,
  tiktok: TiktokIcon,
  twitter: XIcon,
};

const PLATFORM_LABEL: Record<string, string> = {
  facebook: "Facebook",
  instagram: "Instagram",
  youtube: "YouTube",
  tiktok: "TikTok",
  twitter: "X",
};

export async function getStaticPaths() {
  const artists = await getCollection("artists");
  return artists.map((artist) => ({
    params: { slug: artist.id },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const { name, genres, image, socials } = artist.data;
const { Content } = await render(artist);
const hasBody = (artist.body ?? "").trim().length > 0;

// The name runs as a single line of vertical text straddling the photo's
// right edge. At a flat 3x size that's fine for short names but runs
// wildly long for something like "HANNABIELL & THE MIDNIGHT BLUE
// COLLECTIVE" (41 chars would render ~3600px tall - well past the photo
// and off the top of the viewport). Cap the total vertical run length
// instead of the font size directly: short names still get the full 3x
// treatment, longer ones scale down just enough to stay within a
// reasonable overhang of the photo itself.
const NAME_RUN_BUDGET_PX = 1600;
const NAME_MAX_PX = 153.6; // 9.6rem - the literal 3x target
const NAME_MIN_PX = 20; // floor for readability on very long names
const rawNameFontPx = NAME_RUN_BUDGET_PX / Math.max(name.length, 1);
const nameFontMaxRem = +(Math.min(NAME_MAX_PX, Math.max(NAME_MIN_PX, rawNameFontPx)) / 16).toFixed(3);
const nameFontMinRem = Math.min(6, nameFontMaxRem);
---

<BaseLayout title={name} description={genres.length ? `${name} — ${genres.join(", ")}` : name}>
  <div class="artist-page">
    <div class="wrap back-row">
      <a class="eyebrow back-link" href="/artists/">&lt; Back to Artists</a>
    </div>

    <div class="wrap photo-wrap">
      <div class="artist-photo-frame">
        <Image src={image} alt={name} width={900} height={1080} class="artist-photo" />

        <div class="artist-name-strip">
          <h1 class="artist-name" style={`font-size: clamp(${nameFontMinRem}rem, 27vw, ${nameFontMaxRem}rem);`}>{name}</h1>
        </div>

        {
          socials.length > 0 && (
            <div class="artist-socials-strip">
              {socials.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${name} on ${PLATFORM_LABEL[s.platform] ?? s.platform}`}
                >
                  {PLATFORM_ICON[s.platform] ? (
                    <span
                      class="social-icon"
                      style={`-webkit-mask-image:url("${PLATFORM_ICON[s.platform].src}"); mask-image:url("${PLATFORM_ICON[s.platform].src}");`}
                    />
                  ) : (
                    <span class="social-fallback">{PLATFORM_LABEL[s.platform] ?? s.platform}</span>
                  )}
                </a>
              ))}
            </div>
          )
        }

        {genres.length > 0 && <p class="artist-genre-strip">{genres.join(", ")}</p>}
      </div>
    </div>

    {
      hasBody && (
        <div class="wrap artist-about-wrap">
          <div class="artist-about-body">
            <Content />
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .artist-page {
    background: var(--stage-black);
    color: var(--off-white);
    padding-bottom: var(--space-6);
    overflow-x: clip;
  }

  .back-row {
    padding-top: var(--space-3);
  }

  .back-link {
    display: inline-block;
    color: var(--chai-gold);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .photo-wrap {
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    display: flex;
    justify-content: center;
  }

  .artist-photo-frame {
    position: relative;
    width: 100%;
    max-width: 560px;
  }

  .artist-photo-frame :global(.artist-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: cover;
  }

  /* Name runs vertically along the photo's right edge, the edge itself
     bisecting the text - half over the image, half hanging into the black
     background - matching the layout on the original site. */
  .artist-name-strip {
    position: absolute;
    top: 50%;
    right: 0;
    writing-mode: vertical-rl;
    translate: 50% -50%;
    rotate: 180deg;
    pointer-events: none;
  }

  .artist-name {
    margin: 0;
    font-size: clamp(6rem, 27vw, 9.6rem);
    line-height: 1;
    color: var(--chai-gold);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Social icons stack along the photo's left edge toward the bottom, the
     edge bisecting each icon the same way. */
  .artist-socials-strip {
    position: absolute;
    left: 0;
    bottom: 14%;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .artist-socials-strip a {
    display: block;
    opacity: 0.9;
    transition: opacity 0.15s ease, background-color 0.15s ease;
  }

  .artist-socials-strip a:hover {
    opacity: 1;
  }

  .social-icon {
    display: block;
    width: 102px;
    height: 102px;
    background-color: var(--off-white);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    transition: background-color 0.15s ease;
  }

  .artist-socials-strip a:hover .social-icon {
    background-color: var(--chai-gold);
  }

  .social-fallback {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--off-white);
  }

  /* Genre sits at the bottom-right corner, the bottom edge bisecting it the
     same way as the other two straddling elements. */
  .artist-genre-strip {
    position: absolute;
    bottom: 0;
    right: 6%;
    translate: 0 50%;
    margin: 0;
    font-style: italic;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--off-white);
    white-space: nowrap;
    font-size: clamp(2rem, 6.4vw, 3.2rem);
  }

  .artist-about-wrap {
    max-width: 700px;
    text-align: center;
  }

  .artist-about-body :global(p) {
    opacity: 0.85;
    line-height: 1.7;
    font-size: 1.6rem;
    margin-bottom: 1em;
  }

  @media (max-width: 560px) {
    .artist-photo-frame {
      max-width: 380px;
    }

    .artist-name {
      font-size: 3.2rem;
    }

    .artist-genre-strip {
      font-size: 1.3rem;
    }

    .social-icon {
      width: 64px;
      height: 64px;
    }

    .artist-about-body :global(p) {
      font-size: 1.2rem;
    }
  }
</style>
