---
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import sharp from "sharp";

import FacebookIcon from "../../assets/images/social/facebook.png";
import InstagramIcon from "../../assets/images/social/instagram.png";
import YoutubeIcon from "../../assets/images/social/youtube.png";
import TiktokIcon from "../../assets/images/social/tiktok.svg";
import XIcon from "../../assets/images/social/x.svg";

const PLATFORM_ICON: Record<string, ImageMetadata> = {
  facebook: FacebookIcon,
  instagram: InstagramIcon,
  youtube: YoutubeIcon,
  tiktok: TiktokIcon,
  twitter: XIcon,
};

const PLATFORM_LABEL: Record<string, string> = {
  facebook: "Facebook",
  instagram: "Instagram",
  youtube: "YouTube",
  tiktok: "TikTok",
  twitter: "X",
};

export async function getStaticPaths() {
  const artists = await getCollection("artists");
  return artists.map((artist) => ({
    params: { slug: artist.id },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const { name, genres, image, socials } = artist.data;
const { Content } = await render(artist);
const hasBody = (artist.body ?? "").trim().length > 0;

// The name runs as a single line of vertical text straddling the photo's
// right edge. Cap the total vertical run length instead of the font size
// directly: short names still get the full treatment, longer ones scale
// down just enough to stay within a reasonable overhang of the photo.
const NAME_RUN_BUDGET_PX = 800;
const NAME_MAX_PX = 76.8; // 4.8rem
const NAME_MIN_PX = 14; // floor for readability on very long names
const rawNameFontPx = NAME_RUN_BUDGET_PX / Math.max(name.length, 1);
const nameFontMaxRem = +(Math.min(NAME_MAX_PX, Math.max(NAME_MIN_PX, rawNameFontPx)) / 16).toFixed(3);
const nameFontMinRem = Math.min(3, nameFontMaxRem);

// Pick a name colour that reads clearly against whatever photo is behind
// it: black on a mostly-light photo, white on a mostly-dark one, and gold
// when the photo's tones are too mixed/contrasty for either to reliably
// read well against all of it.
let nameColor = "var(--chai-gold)";
try {
  const filePath = path.join(process.cwd(), "public", image.replace(/^\//, ""));
  const { channels } = await sharp(filePath).stats();
  const [r, g, b] = channels;
  const meanLuma = 0.299 * r.mean + 0.587 * g.mean + 0.114 * b.mean;
  const avgStdev = (r.stdev + g.stdev + b.stdev) / 3;
  if (avgStdev > 72) {
    nameColor = "var(--chai-gold)";
  } else if (meanLuma > 150) {
    nameColor = "var(--stage-black)";
  } else {
    nameColor = "var(--off-white)";
  }
} catch {
  // Fall back to gold above if the file can't be read.
}
---

<BaseLayout title={name} description={genres.length ? `${name} — ${genres.join(", ")}` : name}>
  <div class="artist-page">
    <div class="wrap back-row">
      <a class="eyebrow back-link" href="/artists/">&lt; Back to Artists</a>
    </div>

    <div class="wrap photo-wrap">
      <div class="artist-photo-frame">
        <Image src={image} alt={name} width={1120} height={995} class="artist-photo" />

        <div class="artist-name-strip">
          <h1
            class="artist-name"
            style={`font-size: clamp(${nameFontMinRem}rem, 12vw, ${nameFontMaxRem}rem); color: ${nameColor};`}
          >
            {name}
          </h1>
        </div>

        {
          socials.length > 0 && (
            <div class="artist-socials-strip">
              {socials.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${name} on ${PLATFORM_LABEL[s.platform] ?? s.platform}`}
                  data-platform={s.platform}
                >
                  {PLATFORM_ICON[s.platform] ? (
                    <span
                      class="social-icon"
                      style={`-webkit-mask-image:url("${PLATFORM_ICON[s.platform].src}"); mask-image:url("${PLATFORM_ICON[s.platform].src}");`}
                    />
                  ) : (
                    <span class="social-fallback">{PLATFORM_LABEL[s.platform] ?? s.platform}</span>
                  )}
                </a>
              ))}
            </div>
          )
        }

        {genres.length > 0 && <p class="artist-genre-strip">{genres.join(", ")}</p>}
      </div>
    </div>

    {
      hasBody && (
        <div class="wrap artist-about-wrap">
          <div class="artist-about-body">
            <Content />
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .artist-page {
    background: var(--stage-black);
    color: var(--off-white);
    padding-bottom: var(--space-6);
    overflow-x: clip;
  }

  .back-row {
    padding-top: var(--space-3);
  }

  .back-link {
    display: inline-block;
    color: var(--chai-gold);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .photo-wrap {
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    display: flex;
    justify-content: center;
  }

  .artist-photo-frame {
    position: relative;
    width: 100%;
    max-width: 1120px;
  }

  .artist-photo-frame :global(.artist-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 8;
    object-fit: cover;
  }

  /* Name runs vertically along the photo's right edge, the edge itself
     bisecting the text - half over the image, half hanging into the black
     background - matching the layout on the original site. */
  .artist-name-strip {
    position: absolute;
    top: 50%;
    right: 0;
    writing-mode: vertical-rl;
    translate: 50% -50%;
    rotate: 180deg;
    pointer-events: none;
  }

  .artist-name {
    margin: 0;
    font-size: clamp(3rem, 12vw, 4.8rem);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Social icons stack along the photo's left edge toward the bottom, the
     edge bisecting each icon the same way. */
  .artist-socials-strip {
    position: absolute;
    left: 0;
    bottom: 14%;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .artist-socials-strip a {
    display: block;
    opacity: 0.9;
    transition: opacity 0.15s ease, background-color 0.15s ease;
  }

  .artist-socials-strip a:hover {
    opacity: 1;
  }

  .social-icon {
    display: block;
    width: 48px;
    height: 48px;
    background-color: var(--off-white);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    transition: background-color 0.15s ease;
  }

  /* The source icon glyphs don't share the same amount of internal padding
     (Instagram's fills almost the whole canvas, YouTube's leaves a lot of
     margin), so at a shared mask-size they don't read as the same size.
     Facebook is the visual reference point; Instagram is scaled down and
     YouTube scaled up to match it. */
  .artist-socials-strip a[data-platform="instagram"] .social-icon {
    -webkit-mask-size: 78%;
    mask-size: 78%;
  }

  .artist-socials-strip a[data-platform="youtube"] .social-icon {
    -webkit-mask-size: 165%;
    mask-size: 165%;
  }

  .artist-socials-strip a:hover .social-icon {
    background-color: var(--chai-gold);
  }

  .social-fallback {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--off-white);
  }

  /* Genre sits inside the photo's bottom-right corner, its trailing edge a
     fixed 16px in from the photo's right edge. */
  .artist-genre-strip {
    position: absolute;
    bottom: 16px;
    right: 16px;
    margin: 0;
    font-style: italic;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--off-white);
    white-space: nowrap;
    font-size: clamp(0.85rem, 1.6vw, 1.1rem);
  }

  .artist-about-wrap {
    max-width: 1120px;
    text-align: center;
  }

  .artist-about-body :global(p) {
    opacity: 0.85;
    line-height: 1.7;
    font-size: 1.35rem;
    margin-bottom: 1em;
  }

  @media (max-width: 560px) {
    .artist-photo-frame {
      max-width: 380px;
    }

    .artist-name {
      font-size: 1.8rem;
    }

    .artist-genre-strip {
      font-size: 0.7rem;
      bottom: 10px;
      right: 10px;
    }

    .social-icon {
      width: 32px;
      height: 32px;
    }

    .artist-about-body :global(p) {
      font-size: 1.05rem;
    }
  }
</style>
