---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Highlight from "../../components/Highlight.astro";
import { getEntry } from "astro:content";
import { getAllProducts, isShopifyConfigured, type ShopifyProduct } from "../../lib/shopify";

import HeroImg from "../../assets/images/backgrounds/orange-3.png";
import { Image } from "astro:assets";

const siteContent = await getEntry("site", "shop");
const currency = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP" });

// Shopify isn't wired up yet in every environment (local dev without the
// token, or before the Storefront API token has been generated) — fail soft
// into an empty grid with a note, rather than breaking the whole build.
let products: ShopifyProduct[] = [];
if (isShopifyConfigured()) {
  try {
    products = await getAllProducts();
  } catch (err) {
    console.error("Failed to fetch products from Shopify:", err);
  }
}
---

<BaseLayout title="Shop" description="Chai Wallahs merch — 50% of all profits reinvested into grassroots initiatives.">
  <section class="shop-hero">
    <Image src={HeroImg} alt="" class="shop-hero-img" width={2000} height={900} priority />
    <div class="shop-hero-scrim"></div>
    <div class="wrap shop-hero-content">
      <p class="eyebrow">&gt; We Got Merch</p>
      <h1>Wear the<br /><Highlight rotate={-1.5}>Stamp</Highlight></h1>
      <p class="shop-hero-sub">{siteContent?.data.heroSub}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {
        products.length === 0 ? (
          <p class="shop-empty">{siteContent?.data.unavailableNote ?? "The shop's taking a breather — check back shortly."}</p>
        ) : (
          <div class="product-grid">
            {products.map((p) => {
              const hoverImage = p.images[1];
              return (
                <a class="product-card" href={`/shop/${p.handle}/`}>
                  <div class="product-media">
                    {p.featuredImage && (
                      <img
                        src={p.featuredImage.url}
                        alt={p.featuredImage.altText ?? p.title}
                        width={640}
                        height={640}
                        class="product-img product-img--front"
                        loading="lazy"
                      />
                    )}
                    {hoverImage && (
                      <img src={hoverImage.url} alt="" width={640} height={640} class="product-img product-img--back" loading="lazy" />
                    )}
                  </div>
                  <p class="product-name">{p.title}</p>
                  <p class="product-price">
                    {p.availableForSale ? currency.format(Number(p.priceRange.minVariantPrice.amount)) : "Sold out"}
                  </p>
                </a>
              );
            })}
          </div>
        )
      }
      <p class="shop-note">{siteContent?.data.shopNote}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .shop-hero {
    position: relative;
    min-height: 48vh;
    display: flex;
    align-items: flex-end;
    color: var(--off-white);
    overflow: hidden;
  }

  .shop-hero :global(.shop-hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(27, 21, 17, 0.92) 15%, rgba(27, 21, 17, 0.3) 100%);
  }

  .shop-hero-content {
    position: relative;
    padding: var(--space-5) var(--space-3);
  }

  .shop-hero-content .eyebrow {
    color: var(--chai-gold);
    margin-bottom: var(--space-1);
  }

  .shop-hero-content h1 {
    color: var(--off-white);
  }

  .shop-hero-sub {
    max-width: 48ch;
    margin-top: var(--space-2);
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .section {
    background: var(--stage-black);
    color: var(--off-white);
  }

  .shop-empty {
    padding: var(--space-5) 0;
    text-align: center;
    opacity: 0.7;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .product-card {
    text-decoration: none;
    color: var(--off-white);
    display: block;
  }

  .product-media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    margin-bottom: var(--space-2);
    background: rgba(239, 239, 239, 0.06);
  }

  .product-media .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .product-media .product-img--front {
    position: relative;
  }

  .product-media .product-img--back {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .product-card:hover .product-media .product-img--front {
    opacity: 0;
  }

  .product-card:hover .product-media .product-img--back {
    opacity: 1;
    transform: scale(1.04);
  }

  .product-name {
    font-weight: 700;
    margin-bottom: 0.2rem;
    color: var(--off-white);
  }

  .product-price {
    font-family: var(--font-mono);
    color: var(--off-white);
    opacity: 0.75;
  }

  .shop-note {
    font-size: 0.9rem;
    color: var(--off-white);
    opacity: 0.6;
    max-width: 60ch;
  }

  @media (max-width: 860px) {
    .product-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 499px) {
    .product-grid {
      grid-template-columns: 1fr;
    }

    .shop-hero {
      min-height: 33.6vh;
      align-items: center;
    }

    .shop-hero-content {
      text-align: center;
    }

    .shop-hero-sub {
      display: none;
    }
  }

  @media (min-width: 500px) and (max-width: 850px) {
    .shop-hero {
      min-height: 38vh;
      align-items: center;
    }

    .shop-hero-content {
      text-align: center;
    }

    .product-media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
