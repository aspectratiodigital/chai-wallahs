---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Highlight from "../components/Highlight.astro";

import HeroPhoto from "../assets/images/wiab/wiab-hero-crowd.jpg";
import EthosPhoto from "../assets/images/wiab/wiab-crowd.jpg";
import BlackboardBg from "../assets/images/backgrounds/plum-1.png";
import WiabSticker from "../assets/images/logos/wiab-sticker.svg";
import ChaiStageImg from "../assets/images/gallery/chai-stage.jpg";
import SquiggleIcon from "../assets/images/symbols/white/Roots1.png";
import WildThingsImg from "../assets/images/wiab/venue-wild-things.jpg";
import GrandUnionImg from "../assets/images/wiab/venue-grand-union.jpg";
import BohemianImg from "../assets/images/wiab/venue-bohemian.jpg";

import AifLogo from "../assets/images/partners/aif.svg";
import ArtsCouncilLogo from "../assets/images/partners/arts-council-england.svg";
import BauLogo from "../assets/images/partners/bau-drinks.svg";
import BplLogo from "../assets/images/partners/bpl.svg";
import ChaiLogo from "../assets/images/partners/chai-wallahs.svg";
import ClwbLogo from "../assets/images/partners/clwb-ifor-bach.svg";
import DbsLogo from "../assets/images/partners/dbs-institute.svg";
import DosLogo from "../assets/images/partners/diplomats-of-sound.svg";
import FenderLogo from "../assets/images/partners/fender.svg";
import GlobalLocalLogo from "../assets/images/partners/global-local.svg";
import HpaLogo from "../assets/images/partners/hpa.svg";
import JamJarLogo from "../assets/images/partners/jam-jar-bristol.svg";
import MelancholyClownLogo from "../assets/images/partners/melancholy-clown.svg";
import MesaLogo from "../assets/images/partners/mesa-engineering.svg";
import MvtLogo from "../assets/images/partners/music-venue-trust.svg";
import ProofLogo from "../assets/images/partners/proof-drinks.svg";
import SaveOurSceneLogo from "../assets/images/partners/save-our-scene.svg";
import SgpLogo from "../assets/images/partners/secret-garden-party.svg";
import The100ClubLogo from "../assets/images/partners/the-100-club.svg";
import BeatGoesOnLogo from "../assets/images/partners/the-beat-goes-on.svg";
import TwAudioLogo from "../assets/images/partners/tw-audio.svg";
import YamahaLogo from "../assets/images/partners/yamaha.svg";
import LeedsConservatoireLogo from "../assets/images/partners/leeds-conservatoire.svg";
import AspectRatioLogo from "../assets/images/partners/aspect-ratio.svg";
import GreenmanLogo from "../assets/images/partners/greenman.svg";
import NewBristolBreweryLogo from "../assets/images/partners/new-bristol-brewery.svg";

// Trinity & Kendal Calling are multi-layer vectors — mask-image would flatten them to
// one silhouette, so they're inlined raw with dark paths on currentColor (recolours with
// hover like every other logo) and light paths fixed off-white.
import TrinityLogoRaw from "../assets/images/partners/trinity-bristol.svg?raw";
import KendalCallingLogoRaw from "../assets/images/partners/kendal-calling.svg?raw";

const TICKETS_URL = "https://events.humanitix.com/where-it-all-began-festival?c=chai-wallahs";
const SITE_URL = "https://www.whereitallbeganfestival.org";

const doesMean = [
  "Same people. Same standards. New scale.",
  "Chai's history is the proof this way works.",
  "When we talk about WIAB, we're the people behind it — not the brand behind it.",
];

const doesntMean = [
  'WIAB isn\'t "Chai Wallahs presents."',
  "We don't lend our name to take the credit.",
  "This isn't a rebrand of Chai — it's something new, from people you already know.",
];

const venues = [
  {
    image: ChaiStageImg,
    name: "Chai Wallahs",
    text: "The UK's unrivalled, critically acclaimed, independent festival venue. The alternative to the mainstream.",
  },
  {
    image: WildThingsImg,
    name: "Where The Wild Things Are",
    text: "The iconic open-air stage from our friends at Secret Garden Party.",
  },
  {
    image: GrandUnionImg,
    name: "The Grand Union",
    text: "Could be a venue, could be a village. A collaborative programming project from the country's leading grassroots music venues.",
  },
  {
    image: BohemianImg,
    name: "The Bohemian Triangle",
    text: "An ever-shifting dance experience. Follow your ears, chase the vibe, and move through eclectic spaces as the rhythm shifts, sun-up til sun-up.",
  },
];

const stats = [
  { target: 190000, prefix: "£", label: "Raised So Far" },
  { target: 4, prefix: "", label: "Venues & Stages" },
  { target: 3, prefix: "", label: "Days" },
  { target: 0, prefix: "", label: "Shareholders" },
];

// Real partners + live links, scraped from whereitallbeganfestival.org/about-us
const partners = [
  { name: "Chai Wallahs", url: "https://www.chaiwallahs.co.uk", logo: ChaiLogo },
  { name: "Diplomats of Sound", url: "https://diplomatsofsound.org", logo: DosLogo },
  { name: "Arts Council England", url: "https://www.artscouncil.org.uk/", logo: ArtsCouncilLogo },
  { name: "Secret Garden Party", url: "https://www.secretgardenparty.com", logo: SgpLogo },
  { name: "The Beat Goes On", url: "https://thebeatgoesonfestival.com", logo: BeatGoesOnLogo, large: true },
  { name: "Global Local", url: "https://www.globallocal.co.uk/festivalandcarnivallabbristol", logo: GlobalLocalLogo },
  { name: "dBs Institute", url: "https://www.dbsinstitute.ac.uk", logo: DbsLogo },
  { name: "Leeds Conservatoire", url: "https://www.leedsconservatoire.ac.uk", logo: LeedsConservatoireLogo, xsmall: true },
  { name: "Music Venue Trust", url: "https://www.musicvenuetrust.com", logo: MvtLogo, large: true },
  { name: "Association of Independent Festivals", url: "https://www.aiforg.com", logo: AifLogo },
  { name: "Save Our Scene", url: "https://www.saveourscene.uk", logo: SaveOurSceneLogo },
  { name: "Trinity Bristol", url: "https://www.trinitybristol.org.uk", inlineSvg: TrinityLogoRaw },
  { name: "The Jam Jar Bristol", url: "https://www.thejamjarbristol.com", logo: JamJarLogo },
  { name: "Clwb Ifor Bach", url: "https://clwb.net", logo: ClwbLogo, small: true },
  { name: "The 100 Club", url: "https://the100club.co.uk", logo: The100ClubLogo },
  { name: "HPA", url: "https://hpa.uk.com", logo: HpaLogo },
  { name: "Melancholy Clown", url: "https://www.melancholyclown.com/", logo: MelancholyClownLogo },
  { name: "New Bristol Brewery", url: "https://www.newbristolbrewery.co.uk/", logo: NewBristolBreweryLogo, invert: true },
  { name: "Bau Drinks", url: "https://baudrinks.com/", logo: BauLogo },
  { name: "Proof", url: "https://proofdrinks.com", logo: ProofLogo },
  { name: "TW Audio", url: "https://twaudio.de/", logo: TwAudioLogo },
  { name: "Fender", url: "https://uk.fender.com/", logo: FenderLogo },
  { name: "BPL", url: "https://www.bplglobal.co.uk/", logo: BplLogo },
  { name: "Mesa Engineering", url: "https://www.mesaboogie.com/en-US/", logo: MesaLogo },
  { name: "Yamaha Audio", url: "https://uk.yamaha.com/en/audio/home-audio/", logo: YamahaLogo },
  { name: "Aspect Ratio Digital", url: "http://aspectratiodigital.com", logo: AspectRatioLogo, small: true },
  { name: "Green Man Festival", url: "https://www.greenman.net", logo: GreenmanLogo, small: true },
  { name: "Kendal Calling", url: "https://www.kendalcalling.co.uk", inlineSvg: KendalCallingLogoRaw },
];
---

<BaseLayout title="Where It All Began" description="A new festival from the people behind Chai Wallahs. Same standards, new scale.">
  <section class="wiab-hero">
    <Image src={HeroPhoto} alt="" class="wiab-hero-img" width={2200} height={1467} priority />
    <div class="wiab-hero-scrim"></div>
    <div class="wrap wiab-hero-content">
      <Image src={WiabSticker} alt="Where It All Began" width={176} height={154} class="wiab-hero-logo" />
      <h1>Where It All Began</h1>
      <p class="wiab-hero-sub">Brought to you by the people behind Chai Wallahs.</p>
      <div class="wiab-hero-ctas">
        <a href={TICKETS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-solid">Get Tickets</a>
        <a href={SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline wiab-hero-outline">Find Out More</a>
      </div>
    </div>
  </section>

  <!-- WHAT IS WIAB -->
  <section class="section intro">
    <div class="wrap intro-grid">
      <div>
        <p class="eyebrow">&gt; What Is WIAB</p>
        <h2>We're the <Highlight rotate={-1}>people</Highlight><br />behind it.</h2>
      </div>
      <p class="intro-copy">
        27 years of Chai Wallahs proved something — that you can run things fairly, pay people properly,
        and build a real community, and it works. Not as a nice idea. As a model that lasts. Where It All
        Began is what happens when the same people ask: what if we built a whole festival that way? It's
        not our name on someone else's idea. It's the same hands, the same standards, the same belief —
        applied to something bigger than one stage.
      </p>
    </div>
  </section>

  <!-- WHAT THIS MEANS — blackboard -->
  <section class="means-band">
    <Image src={BlackboardBg} alt="" class="means-bg" width={2200} height={1400} />
    <div class="means-scrim"></div>
    <div class="wrap means-grid">
      <div class="means-col">
        <h3 class="means-yes">What This <Highlight color="gold" rotate={-1}>Means</Highlight></h3>
        <ul style={`--squiggle:url("${SquiggleIcon.src}");`}>
          {doesMean.map((line) => <li>{line}</li>)}
        </ul>
      </div>
      <div class="means-col">
        <h3 class="means-no">What This <Highlight color="ember" rotate={1}>Doesn't Mean</Highlight></h3>
        <ul style={`--squiggle:url("${SquiggleIcon.src}");`}>
          {doesntMean.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- VENUES — accordion hover -->
  <section class="section venues">
    <div class="wrap">
      <p class="eyebrow venues-label">&gt; The Site</p>
      <h2>Four venues. One festival.</h2>
      <p class="venues-intro">
        Held at the iconic home of Secret Garden Party — Grange Farm, Abbots Ripton. Alongside sharing the
        site, the SGP team programme their own stage, bringing their unmistakable spirit and creative
        chaos into the heart of the festival. A familiar setting, reimagined for something new.
      </p>
      <div class="venues-accordion">
        {
          venues.map((v) => (
            <div class="venue-tile">
              <Image src={v.image} alt={v.name} width={900} height={700} class="venue-photo" />
              <div class="venue-caption">
                <h3>{v.name}</h3>
                <p>{v.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="wiab-stats">
    <div class="wrap wiab-stats-grid">
      {
        stats.map((s) => {
          const finalText = s.prefix + s.target.toLocaleString("en-GB");
          return (
            <div>
              <span
                class="stat-num"
                data-target={s.target}
                data-prefix={s.prefix}
                style={`min-width:${finalText.length}ch;`}
              >
                {s.prefix}0
              </span>
              <span class="stat-label">{s.label}</span>
            </div>
          );
        })
      }
    </div>
    <div class="wiab-stats-marquee">
      <div class="wiab-stats-track">
        {
          [0, 1].map((copy) => (
            <div class="wiab-stats-set" aria-hidden={copy === 1 ? "true" : undefined}>
              {
                stats.map((s) => {
                  const finalText = s.prefix + s.target.toLocaleString("en-GB");
                  return (
                    <div class="stat-item">
                      <span
                        class="stat-num"
                        data-target={s.target}
                        data-prefix={s.prefix}
                        style={`min-width:${finalText.length}ch;`}
                      >
                        {s.prefix}0
                      </span>
                      <span class="stat-label">{s.label}</span>
                    </div>
                  );
                })
              }
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ETHOS -->
  <section class="section festival-info">
    <div class="wrap festival-info-grid">
      <Image src={EthosPhoto} alt="Crowd at a Chai Wallahs show" width={900} height={900} class="festival-photo" />
      <div>
        <p class="eyebrow">&gt; The Ethos</p>
        <h2>A return to the roots</h2>
        <p class="festival-copy">
          A place where the creative spirit and the core values of festival culture are upheld. High
          quality production is standard, musical diversity the foundation, and audiences feel valued,
          respected, and part of a deep sense of community. No shareholders. Artists paid fairly. Every
          partner benefits from the success.
        </p>
        <p class="festival-meta">Fri 18 &ndash; Sun 20 June 2027 &middot; Grange Farm, Abbots Ripton, Cambridgeshire</p>
        <a href={TICKETS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Get Tickets</a>
      </div>
    </div>
  </section>

  <!-- THE COLLECTIVE -->
  <section class="section partners">
    <div class="wrap">
      <div class="partners-heading">
        <p class="eyebrow partners-label">&gt; The Collective</p>
        <h2>Our Partners</h2>
      </div>
      <div class="partners-grid">
        {
          partners.map((p, i) =>
            p.inlineSvg ? (
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="partner-tile" aria-label={p.name} style={`--i:${i};`}>
                <span class="partner-logo partner-logo--inline" set:html={p.inlineSvg} />
              </a>
            ) : (
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="partner-tile" aria-label={p.name} style={`--i:${i};`}>
                <span
                  class:list={["partner-logo", { "partner-logo--small": p.small, "partner-logo--xsmall": p.xsmall, "partner-logo--large": p.large, "partner-logo--invert": p.invert }]}
                  style={
                    p.invert
                      ? `--logo-url:url("${p.logo.src}");`
                      : `-webkit-mask-image:url("${p.logo.src}"); mask-image:url("${p.logo.src}");`
                  }
                />
              </a>
            ),
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const nums = Array.from(document.querySelectorAll<HTMLElement>(".stat-num[data-target]"));
  const formatter = new Intl.NumberFormat("en-GB");
  const statsSection = document.querySelector(".wiab-stats");

  function animate(el: HTMLElement): Promise<void> {
    return new Promise((resolve) => {
      const target = Number(el.dataset.target ?? "0");
      const prefix = el.dataset.prefix ?? "";
      const duration = target > 100 ? 1200 : 700;
      const start = performance.now();

      function tick(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const value = Math.floor(eased * target);
        el.textContent = prefix + formatter.format(value);
        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          el.textContent = prefix + formatter.format(target);
          resolve();
        }
      }
      requestAnimationFrame(tick);
    });
  }

  async function runSequence() {
    const order: number[] = [];
    for (const el of nums) {
      const target = Number(el.dataset.target ?? "0");
      if (!order.includes(target)) order.push(target);
    }
    for (const target of order) {
      const group = nums.filter((el) => Number(el.dataset.target ?? "0") === target);
      await Promise.all(group.map((el) => animate(el)));
      if (target === order[0]) {
        startMarquee();
      }
    }
  }

  // Mobile marquee: sits with the first (£190,000) stat centred while it counts up,
  // then glides into the continuous scroll from that exact position — no jump.
  const marqueeEl = document.querySelector<HTMLElement>(".wiab-stats-marquee");
  const trackEl = document.querySelector<HTMLElement>(".wiab-stats-track");
  const firstSetEl = trackEl?.querySelector<HTMLElement>(".wiab-stats-set:not([aria-hidden])") ?? null;
  const firstItemEl = firstSetEl?.querySelector<HTMLElement>(".stat-item") ?? null;
  let centeredOffset = 0;

  function centerFirstItem() {
    if (!marqueeEl || !trackEl || !firstItemEl) return;
    trackEl.style.transform = "translateX(0px)";
    const marqueeRect = marqueeEl.getBoundingClientRect();
    const trackRect = trackEl.getBoundingClientRect();
    const itemRect = firstItemEl.getBoundingClientRect();
    const isTablet = window.matchMedia("(min-width: 500px) and (max-width: 850px)").matches;
    if (isTablet) {
      // Tablet: anchor the first stat 40px from the left edge instead of centring it.
      const itemLeftInTrack = itemRect.left - trackRect.left;
      centeredOffset = 40 - itemLeftInTrack;
    } else {
      const itemCenterInTrack = itemRect.left - trackRect.left + itemRect.width / 2;
      centeredOffset = marqueeRect.width / 2 - itemCenterInTrack;
    }
    trackEl.style.transform = `translateX(${centeredOffset}px)`;
  }

  function startMarquee() {
    if (!trackEl || !firstSetEl) return;
    // The wrap distance is one set's width PLUS the track's own gap to the next
    // set — not just the set's width — or the loop jumps by that gap each cycle.
    const trackGap = parseFloat(getComputedStyle(trackEl).columnGap || "0");
    const setWidth = firstSetEl.getBoundingClientRect().width + trackGap;
    const speed = setWidth / 18000; // px/ms — same pace as the old 18s-per-loop marquee
    let offset = centeredOffset;
    let lastTime: number | null = null;

    function tick(now: number) {
      if (lastTime === null) lastTime = now;
      offset -= speed * (now - lastTime);
      lastTime = now;
      if (offset <= centeredOffset - setWidth) offset += setWidth;
      if (trackEl) trackEl.style.transform = `translateX(${offset}px)`;
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  if (window.matchMedia("(max-width: 850px)").matches) {
    centerFirstItem();
    // Re-measure once the custom font has actually swapped in — the eyebrow
    // mono font's fallback metrics differ enough to throw the centring off.
    document.fonts?.ready.then(centerFirstItem);
    window.addEventListener("resize", centerFirstItem);
  }

  if (statsSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runSequence();
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 },
    );
    observer.observe(statsSection);
  }

  function alignPartnersHeading() {
    const grid = document.querySelector<HTMLElement>(".partners-grid");
    const heading = document.querySelector<HTMLElement>(".partners-heading");
    const wrap = grid?.closest<HTMLElement>(".wrap");
    if (!grid || !heading || !wrap) return;
    const offset = grid.getBoundingClientRect().left - wrap.getBoundingClientRect().left;
    heading.style.paddingLeft = `${Math.max(offset, 0)}px`;
  }

  window.addEventListener("load", alignPartnersHeading);
  window.addEventListener("resize", alignPartnersHeading);

  const partnersGrid = document.querySelector<HTMLElement>(".partners-grid");
  if (partnersGrid) {
    const partnersObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            partnersGrid.classList.add("is-visible");
            partnersObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );
    partnersObserver.observe(partnersGrid);
  }
</script>

<style>
  .wiab-hero {
    position: relative;
    min-height: 64vh;
    display: flex;
    align-items: flex-end;
    color: var(--off-white);
    overflow: hidden;
  }

  .wiab-hero :global(.wiab-hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) sepia(1) hue-rotate(245deg) saturate(0.9) brightness(0.78) contrast(1.3);
  }

  .wiab-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(27, 21, 17, 0.9) 5%, rgba(66, 36, 56, 0.35) 65%, rgba(66, 36, 56, 0.15) 100%);
  }

  .wiab-hero-content {
    position: relative;
    padding: var(--space-5) var(--space-3);
  }

  .wiab-hero-logo {
    margin-bottom: var(--space-1);
  }

  .wiab-hero-content h1 {
    color: var(--off-white);
  }

  .wiab-hero-sub {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.9rem;
    opacity: 0.85;
    margin-top: var(--space-2);
  }

  .wiab-hero-ctas {
    margin-top: var(--space-3);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .wiab-hero-ctas .btn-solid {
    --btn-accent: var(--off-white);
    background: var(--btn-accent);
    color: var(--crown);
    border-color: var(--btn-accent);
  }

  /* INTRO — B (black) */
  .intro {
    background: var(--stage-black);
    color: var(--off-white);
    min-height: 46vh;
    display: flex;
    align-items: center;
  }

  .intro .eyebrow {
    color: var(--chai-gold);
    margin-bottom: var(--space-1);
  }

  .intro h2 {
    color: var(--off-white);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-5);
    align-items: center;
    width: 100%;
  }

  .intro-copy {
    font-size: 1.05rem;
    opacity: 0.9;
  }

  /* MEANS — A (blackboard) */
  .means-band {
    position: relative;
    color: var(--off-white);
    overflow: hidden;
    padding: var(--space-6) 0;
  }

  .means-band :global(.means-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .means-scrim {
    position: absolute;
    inset: 0;
    background: rgba(30, 15, 26, 0.82);
  }

  .means-grid {
    position: relative;
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: var(--space-5);
  }

  .means-col h3 {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.92rem, 3.12vw, 2.64rem);
    letter-spacing: 0.01em;
    color: var(--off-white);
    margin-bottom: var(--space-3);
  }

  /* Below 470px "WHAT THIS DOESN'T MEAN" won't fit on one line at the base clamp —
     shrink both headings together (they share this rule) so they stay matched in
     size, and force the single line now that it's guaranteed to fit. */
  @media (max-width: 470px) {
    .means-col h3 {
      font-size: clamp(1.05rem, 7vw, 1.4rem);
      white-space: nowrap;
    }
  }

  .means-no :global(.highlight-word) {
    padding-left: 0.6em;
    padding-right: 0.6em;
  }

  .means-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .means-col li {
    position: relative;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(0.92rem, 1.28vw, 1.2rem);
    line-height: 1.3;
    letter-spacing: 0.01em;
