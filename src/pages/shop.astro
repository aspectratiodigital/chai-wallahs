---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Highlight from "../components/Highlight.astro";
import { getCollection, getEntry } from "astro:content";

import HeroImg from "../assets/images/backgrounds/orange-3.png";

const STORE_URL = "https://www.chaiwallahs.co.uk/category/all-products";

const siteContent = await getEntry("site", "shop");
const products = await getCollection("products");
const currency = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP" });
---

<BaseLayout title="Shop" description="Chai Wallahs merch — 50% of all profits reinvested into grassroots initiatives.">
  <section class="shop-hero">
    <Image src={HeroImg} alt="" class="shop-hero-img" width={2000} height={900} priority />
    <div class="shop-hero-scrim"></div>
    <div class="wrap shop-hero-content">
      <p class="eyebrow">&gt; We Got Merch</p>
      <h1>Wear the<br /><Highlight rotate={-1.5}>Stamp</Highlight></h1>
      <p class="shop-hero-sub">{siteContent?.data.heroSub}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="product-grid">
        {
          products.map((p) => (
            <a class="product-card" href={STORE_URL} target="_blank" rel="noopener noreferrer">
              <div class="product-media">
                <Image src={p.data.image} alt={p.data.name} width={640} height={640} class="product-img product-img--front" />
                {p.data.imageHover && (
                  <Image src={p.data.imageHover} alt="" width={640} height={640} class="product-img product-img--back" />
                )}
              </div>
              <p class="eyebrow product-category">{p.data.category}</p>
              <p class="product-name">{p.data.name}</p>
              <p class="product-price">{currency.format(p.data.price)}</p>
            </a>
          ))
        }
      </div>
      <p class="shop-note">{siteContent?.data.shopNote}</p>
      <a href={STORE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-solid">Visit the Full Store</a>
    </div>
  </section>
</BaseLayout>

<style>
  .shop-hero {
    position: relative;
    min-height: 48vh;
    display: flex;
    align-items: flex-end;
    color: var(--off-white);
    overflow: hidden;
  }

  .shop-hero :global(.shop-hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(27, 21, 17, 0.92) 15%, rgba(27, 21, 17, 0.3) 100%);
  }

  .shop-hero-content {
    position: relative;
    padding: var(--space-5) var(--space-3);
  }

  .shop-hero-content .eyebrow {
    color: var(--chai-gold);
    margin-bottom: var(--space-1);
  }

  .shop-hero-content h1 {
    color: var(--off-white);
  }

  .shop-hero-sub {
    max-width: 48ch;
    margin-top: var(--space-2);
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .section {
    background: var(--stage-black);
    color: var(--off-white);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .product-card {
    text-decoration: none;
    color: var(--off-white);
    display: block;
  }

  .product-media {
    position: relative;
    aspect-ratio: 1;
    background: var(--off-white);
    border: 1px solid rgba(27, 21, 17, 0.1);
    overflow: hidden;
    margin-bottom: var(--space-2);
  }

  .product-media :global(.product-img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .product-media :global(.product-img--front) {
    position: relative;
  }

  .product-media :global(.product-img--back) {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .product-card:hover .product-media :global(.product-img--front) {
    opacity: 0;
  }

  .product-card:hover .product-media :global(.product-img--back) {
    opacity: 1;
    transform: scale(1.04);
  }

  .product-placeholder {
    width: 100%;
    height: 100%;
    background: var(--chai-gold);
  }

  .product-category {
    color: var(--chai-gold);
    margin-bottom: 0.3rem;
  }

  .product-name {
    font-weight: 700;
    margin-bottom: 0.2rem;
    color: var(--off-white);
  }

  .product-price {
    font-family: var(--font-mono);
    color: var(--off-white);
    opacity: 0.75;
  }

  .shop-note {
    font-size: 0.9rem;
    color: var(--off-white);
    opacity: 0.6;
    max-width: 60ch;
    margin-bottom: var(--space-3);
  }

  @media (max-width: 860px) {
    .product-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 499px) {
    .product-grid {
      grid-template-columns: 1fr;
    }

    .shop-hero {
      min-height: 33.6vh;
    }

    .shop-hero-sub {
      display: none;
    }
  }

  @media (min-width: 500px) and (max-width: 850px) {
    /* General tablet shrink — pages were running too tall */
    .shop-hero {
      min-height: 38vh;
    }

    /* No white letterboxing behind the product photos — let each image itself
       fill and reshape to the card instead of showing background around it. */
    .product-media {
      aspect-ratio: 4 / 3;
      background: transparent;
      border: none;
    }

    .product-media :global(.product-img) {
      object-fit: cover;
    }
  }
</style>
