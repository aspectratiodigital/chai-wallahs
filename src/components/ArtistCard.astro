---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  artist: CollectionEntry<"artists">;
}

const { artist } = Astro.props;
const { name, genres, image } = artist.data;

const dataName = name.toLowerCase();
const dataGenres = genres.map((g) => g.toLowerCase()).join("|");
---

<a
  href={`/artist/${artist.id}/`}
  class="artist-card"
  data-artist-card
  data-name={dataName}
  data-genres={dataGenres}
>
  <Image src={image} alt={name} width={500} height={625} class="artist-card-img" />
  <div class="artist-card-scrim"></div>
  <div class="artist-card-info">
    <p class="artist-card-name">{name}</p>
    {genres.length > 0 && <p class="artist-card-genre">{genres.join(", ")}</p>}
  </div>
</a>

<style>
  .artist-card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    text-decoration: none;
    background: var(--stage-black);
  }

  .artist-card :global(.artist-card-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* No per-photo face detection - biasing the crop toward the upper third is a
       reasonable default for keeping faces in frame on portrait-cropped promo
       photos and group shots. Flag any specific artist whose photo still crops
       badly and it can be tuned individually via a per-entry override. */
    object-position: center 20%;
    transition: transform 0.35s ease;
  }

  .artist-card:hover :global(.artist-card-img) {
    transform: scale(1.05);
  }

  .artist-card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(27, 21, 17, 0) 50%, rgba(27, 21, 17, 0.92) 100%);
  }

  .artist-card-info {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: var(--space-2);
    text-align: left;
  }

  .artist-card-name {
    color: var(--off-white);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .artist-card-genre {
    color: var(--chai-gold);
    font-style: italic;
    font-size: 0.85rem;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    opacity: 0.9;
    margin-top: 0.25rem;
  }
</style>
