---
// Concept C — Tickets: four festival-ticket stubs instead of four colour
// blocks. Click (or tab to and press enter) and the ticket flips over on
// its long edge to reveal the full story and the CTA, like turning over a
// wristband to read the small print. The box shape matches the site's own
// button shape. `variant="outline"` keeps every ticket off-white; `variant
// ="color"` gives each ticket's outline/icon its track's own brand colour;
// `variant="filled"` fills the whole ticket with that colour, the same way
// the old colour-box contact page did.
import { Image } from "astro:assets";

interface Track {
  id: string;
  title: string;
  text: string;
  blurb: string;
  cta: string;
  subject: string;
  icon: ImageMetadata;
  color: string;
}
interface Props {
  tracks: Track[];
  email: string;
  variant?: "outline" | "color" | "filled";
}
const { tracks, email, variant = "outline" } = Astro.props;

const colorVar: Record<string, string> = {
  ember: "var(--ember)",
  velvet: "var(--velvet)",
  crown: "var(--crown)",
  gold: "var(--chai-gold)",
};
---

<div class:list={["tickets", `tickets--${variant}`]} data-tickets-root>
  {
    tracks.map((t, i) => (
      <div
        class="ticket"
        data-ticket
        tabindex="0"
        role="button"
        aria-pressed="false"
        aria-label={`${t.title} — tap to flip`}
        style={variant !== "outline" ? `--accent:${colorVar[t.color] ?? "var(--chai-gold)"};` : undefined}
      >
        <div class="ticket-inner">
          <div class="ticket-face ticket-front">
            <span
              class="ticket-icon"
              style={`-webkit-mask-image:url("${t.icon.src}"); mask-image:url("${t.icon.src}");`}
            />
            <h3>{t.title}</h3>
            <p class="ticket-blurb">{t.blurb}</p>
            <span class="ticket-flip-hint">Tap to flip &#8635;</span>
          </div>
          <div class="ticket-face ticket-back">
            <p>{t.text}</p>
            <a class="btn btn-outline ticket-cta" href={`mailto:${email}?subject=${encodeURIComponent(t.subject)}`}>{t.cta}</a>
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  function initTickets(root: HTMLElement) {
    const tickets = [...root.querySelectorAll<HTMLElement>("[data-ticket]")];
    tickets.forEach((ticket) => {
      function toggle() {
        const flipped = ticket.classList.toggle("is-flipped");
        ticket.setAttribute("aria-pressed", String(flipped));
      }
      ticket.addEventListener("click", (e) => {
        // Let the CTA link inside the flipped-open back face work normally.
        if ((e.target as HTMLElement).closest("a")) return;
        toggle();
      });
      ticket.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggle();
        }
      });
    });
  }

  document.querySelectorAll<HTMLElement>("[data-tickets-root]").forEach(initTickets);
</script>

<style>
  .tickets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .ticket {
    --accent: var(--off-white);
    perspective: 1400px;
    height: 340px;
    cursor: pointer;
  }

  .ticket:focus-visible {
    outline: 2px solid var(--chai-gold);
    outline-offset: 4px;
  }

  .ticket-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
    transform-style: preserve-3d;
  }

  .ticket.is-flipped .ticket-inner {
    transform: rotateY(180deg);
  }

  .ticket-face {
    position: absolute;
    inset: 0;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border: 2px solid var(--accent);
    /* Same hand-drawn wobble as the site's buttons. */
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    padding: var(--space-3) var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    color: var(--off-white);
    background: #14100c;
    transition: border-color 0.2s ease;
  }

  .ticket-front {
    align-items: flex-start;
    gap: var(--space-2);
  }

  .ticket-icon {
    display: block;
    width: 56px;
    height: 56px;
    margin-top: 0.2em;
    background-color: var(--accent);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    transition: background-color 0.2s ease;
  }

  .ticket-front h3 {
    font-size: 1.9rem;
    color: var(--off-white);
  }

  .ticket-blurb {
    flex: 1;
    opacity: 0.85;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .ticket-flip-hint {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    opacity: 0.9;
  }

  .ticket-back {
    transform: rotateY(180deg);
    justify-content: space-between;
    gap: var(--space-2);
  }

  .ticket-back p {
    opacity: 0.88;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .ticket-back .ticket-cta {
    align-self: flex-start;
  }

  /* Colour variant: the CTA on the back picks up the ticket's own accent too. */
  .tickets--color .ticket-cta {
    --btn-accent: var(--accent);
  }

  /* Filled variant: the whole ticket — front and back — is a solid block of
     the track's colour, off-white text throughout (the brand book's own
     rule: every coloured box gets light text, only the pale "white" boxes
     get dark text), matching the old colour-box contact page. */
  .tickets--filled .ticket-face {
    background: var(--accent);
    border-color: var(--accent);
  }

  .tickets--filled .ticket-icon {
    background-color: var(--off-white);
  }

  .tickets--filled .ticket-flip-hint {
    color: var(--off-white);
  }

  @media (max-width: 860px) {
    .tickets {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .tickets {
      grid-template-columns: 1fr;
    }

    .ticket {
      height: 300px;
    }
  }
</style>
