---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArtistCard from "../components/ArtistCard.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import HeroBg from "../assets/images/backgrounds/plum-1.png";

interface Props {
  year: number;
}

const { year } = Astro.props;

const allArtists = await getCollection("artists");
const artists = allArtists
  .filter((a) => a.data.years.includes(year))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

// Genre pills, deduped case-insensitively (some years used different casing
// conventions on the source site), keeping the first-seen display casing.
const genreByKey = new Map<string, string>();
for (const a of artists) {
  for (const g of a.data.genres) {
    const key = g.toLowerCase();
    if (!genreByKey.has(key)) genreByKey.set(key, g);
  }
}
const genres = [...genreByKey.entries()].sort((a, b) => a[1].localeCompare(b[1]));

const YEARS = [2026, 2025, 2024, 2023];
---

<BaseLayout title={`${year} Artist Roster`} description={`The full ${year} Chai Wallahs artist roster — every act that graced the stage.`}>
  <section class="artists-hero">
    <Image src={HeroBg} alt="" class="artists-hero-img" width={2000} height={700} priority />
    <div class="artists-hero-scrim"></div>
    <div class="wrap artists-hero-content">
      <p class="eyebrow">&gt; The Roster</p>
      <h1>{year} Artists</h1>
      <div class="year-switcher">
        {
          YEARS.map((y) => (
            <a href={y === 2026 ? "/artists/" : `/artists/${y}/`} class:list={["year-pill", { active: y === year }]}>
              {y}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section artists-controls-section">
    <div class="wrap">
      <div class="artists-controls">
        <div class="artist-search-wrap">
          <input
            type="search"
            class="artist-search"
            placeholder="Search artists…"
            data-artist-search
            aria-label="Search artists by name"
          />
          <button type="button" class="search-clear" data-search-clear aria-label="Clear search">&times;</button>
        </div>
        <div class="genre-dropdown" data-genre-dropdown>
          <button type="button" class="genre-dropdown-toggle" data-genre-toggle aria-haspopup="true" aria-expanded="false">
            <span data-genre-toggle-label>Genres</span>
            <span class="genre-dropdown-arrow" aria-hidden="true">&#9662;</span>
          </button>
          <div class="genre-dropdown-panel" data-genre-panel hidden>
            {
              genres.map(([key, label]) => (
                <button type="button" class="genre-pill" data-genre-pill={key}>
                  {label}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <p class="no-results" data-no-results hidden>No artists match your search.</p>

      <div class="artists-grid" data-artist-grid>
        {artists.map((artist) => <ArtistCard artist={artist} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initArtistFilters() {
    const grid = document.querySelector("[data-artist-grid]");
    const searchInput = document.querySelector<HTMLInputElement>("[data-artist-search]");
    const clearBtn = document.querySelector<HTMLButtonElement>("[data-search-clear]");
    const genrePills = [...document.querySelectorAll<HTMLButtonElement>("[data-genre-pill]")];
    const noResults = document.querySelector<HTMLElement>("[data-no-results]");
    const genreDropdown = document.querySelector<HTMLElement>("[data-genre-dropdown]");
    const genreToggle = document.querySelector<HTMLButtonElement>("[data-genre-toggle]");
    const genreToggleLabel = document.querySelector<HTMLElement>("[data-genre-toggle-label]");
    const genrePanel = document.querySelector<HTMLElement>("[data-genre-panel]");
    if (!grid) return;

    const cards = [...grid.querySelectorAll<HTMLElement>("[data-artist-card]")];
    const activeGenres = new Set<string>();

    function updateClearButton() {
      if (!clearBtn || !searchInput) return;
      clearBtn.classList.toggle("visible", searchInput.value.length > 0);
    }

    function applyFilters() {
      const q = (searchInput?.value ?? "").trim().toLowerCase();
      let visibleCount = 0;
      cards.forEach((card) => {
        const name = card.dataset.name ?? "";
        const cardGenres = (card.dataset.genres ?? "").split("|");
        const matchesSearch = !q || name.includes(q);
        const matchesGenre = activeGenres.size === 0 || cardGenres.some((g) => activeGenres.has(g));
        const visible = matchesSearch && matchesGenre;
        // Set inline display directly rather than the `hidden` attribute/property -
        // .artist-card has its own `display: block` rule which (being an author
        // style) beats the UA stylesheet's [hidden] { display: none }, so toggling
        // .hidden alone silently did nothing visually while still "looking" correct
        // in JS state.
        card.style.display = visible ? "" : "none";
        if (visible) visibleCount++;
      });
      if (noResults) noResults.hidden = visibleCount !== 0;
      updateClearButton();
    }

    searchInput?.addEventListener("input", applyFilters);

    clearBtn?.addEventListener("click", () => {
      if (!searchInput) return;
      searchInput.value = "";
      searchInput.focus();
      applyFilters();
    });

    function updateGenreToggleLabel() {
      if (!genreToggleLabel) return;
      genreToggleLabel.textContent = activeGenres.size === 0 ? "Genres" : `Genres (${activeGenres.size})`;
    }

    genrePills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const key = pill.dataset.genrePill ?? "";
        if (activeGenres.has(key)) {
          activeGenres.delete(key);
          pill.classList.remove("active");
        } else {
          activeGenres.add(key);
          pill.classList.add("active");
        }
        updateGenreToggleLabel();
        applyFilters();
      });
    });

    // Dropdown floats over the artist grid rather than push it down the
    // page — opens on click, closes on an outside click, a re-click, or Escape.
    function closeGenrePanel() {
      if (!genrePanel || !genreToggle) return;
      genrePanel.hidden = true;
      genreToggle.setAttribute("aria-expanded", "false");
    }

    function openGenrePanel() {
      if (!genrePanel || !genreToggle) return;
      genrePanel.hidden = false;
      genreToggle.setAttribute("aria-expanded", "true");
    }

    genreToggle?.addEventListener("click", () => {
      if (genrePanel?.hidden) openGenrePanel();
      else closeGenrePanel();
    });

    document.addEventListener("click", (e) => {
      if (!genreDropdown?.contains(e.target as Node)) closeGenrePanel();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeGenrePanel();
    });
  }

  initArtistFilters();

  // Cards fade/rise in as they scroll into view, and reset back out if
  // scrolled back past — both directions toggle the same class, so if a
  // card is already visible on load (nothing to reveal) it just stays put.
  const revealCards = document.querySelectorAll<HTMLElement>("[data-artist-card]");
  if (revealCards.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle("is-visible", entry.isIntersecting);
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -5% 0px" },
    );
    revealCards.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .artists-hero {
    position: relative;
    min-height: 40vh;
    display: flex;
    align-items: flex-end;
    color: var(--off-white);
    overflow: hidden;
  }

  .artists-hero :global(.artists-hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .artists-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(27, 21, 17, 0.95) 20%, rgba(27, 21, 17, 0.4) 100%);
  }

  .artists-hero-content {
    position: relative;
    padding: var(--space-5) var(--space-3);
  }

  .artists-hero-content .eyebrow {
    color: var(--chai-gold);
    margin-bottom: var(--space-1);
  }

  .artists-hero-content h1 {
    color: var(--off-white);
    margin-bottom: var(--space-3);
  }

  .year-switcher {
    display: flex;
    gap: var(--space-2);
  }

  /* Same wobbly-rectangle shape as the site's .btn buttons (see the homepage's
     "See All Events" / "Apply to Play" buttons), reused here instead of the
     site's other box motif (the torn-paper texture) per explicit direction. */
  .year-pill,
  .artist-search-wrap,
  .genre-dropdown-toggle {
    border: 2px solid currentColor;
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
  }

  .year-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.2em;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-align: center;
    color: var(--off-white);
    background: transparent;
    padding: 0.55em 1em;
    transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .year-pill:hover {
    transform: translate(-1px, -1px);
    color: var(--stage-black);
    background: var(--off-white);
    border-color: var(--off-white);
  }

  .year-pill.active {
    color: var(--stage-black);
    background: var(--chai-gold);
    border-color: var(--chai-gold);
  }

  .artists-controls-section {
    background: var(--stage-black);
    color: var(--off-white);
  }

  .artists-controls {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .artist-search-wrap {
    position: relative;
    display: inline-block;
    max-width: 360px;
    width: 100%;
    color: var(--off-white);
  }

  .artist-search {
    font-family: var(--font-body, inherit);
    font-size: 1rem;
    width: 100%;
    padding: 0.75em 2.6em 0.75em 1.1em;
    background: transparent;
    border: none;
    color: var(--off-white);
  }

  .artist-search::placeholder {
    color: rgba(239, 239, 239, 0.5);
  }

  .artist-search:focus {
    outline: none;
  }

  .artist-search::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  .search-clear {
    display: none;
    position: absolute;
    right: 0.6em;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--chai-gold);
    font-size: 1.4rem;
    line-height: 1;
    padding: 0.2em 0.3em;
  }

  .search-clear.visible {
    display: block;
  }

  /* GENRE DROPDOWN: same wobbly box as the search bar, but its panel floats
     over the artist grid below (position: absolute) instead of pushing the
     grid further down the page when it opens. */
  .genre-dropdown {
    position: relative;
  }

  .genre-dropdown-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9em;
    min-width: 220px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--off-white);
    background: transparent;
    padding: 0.75em 1.1em;
    cursor: pointer;
    transition: transform 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .genre-dropdown-toggle:hover {
    transform: translate(-1px, -1px);
  }

  .genre-dropdown-toggle[aria-expanded="true"] {
    color: var(--chai-gold);
    border-color: var(--chai-gold);
  }

  .genre-dropdown-arrow {
    font-size: 0.7em;
    transition: transform 0.2s ease;
  }

  .genre-dropdown-toggle[aria-expanded="true"] .genre-dropdown-arrow {
    transform: rotate(180deg);
  }

  .genre-dropdown-panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    /* Right-aligned to the toggle (which sits well right-of-centre in the
       controls row) so the panel opens back across the row instead of off
       the edge of the viewport, the way left:0 did at in-between widths. */
    right: 0;
    left: auto;
    z-index: 30;
    width: min(380px, calc(100vw - 2 * var(--space-3)));
    max-height: 340px;
    overflow-y: auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    padding: var(--space-2);
    background: var(--stage-black);
    border: 2px solid rgba(239, 239, 239, 0.3);
    border-radius: 15px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
  }

  .genre-dropdown-panel[hidden] {
    display: none;
  }

  .genre-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
    color: var(--off-white);
    font-weight: 700;
    background: transparent;
    border: 2px solid rgba(239, 239, 239, 0.3);
    border-radius: 8px;
    padding: 0.6em 0.5em;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .genre-pill:hover {
    transform: translate(-1px, -1px);
  }

  .genre-pill.active {
    color: var(--stage-black);
    background: var(--chai-gold);
    border-color: var(--chai-gold);
  }

  .no-results {
    opacity: 0.7;
    margin-bottom: var(--space-3);
  }

  .artists-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .artists-grid :global([data-artist-card]) {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .artists-grid :global([data-artist-card].is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1000px) {
    .artists-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 700px) {
    .artists-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 499px) {
    /* HERO: matches the other pages' mobile header — same height, centred text */
    .artists-hero {
      min-height: 33.6vh;
      align-items: center;
    }

    .artists-hero-content {
      text-align: center;
    }

    .year-switcher {
      justify-content: center;
    }

    /* CONTROLS: search bar and genre dropdown stack full-width instead of
       sitting side by side, and the dropdown panel matches that full width. */
    .artists-controls {
      flex-direction: column;
    }

    .artist-search-wrap,
    .genre-dropdown,
    .genre-dropdown-toggle {
      max-width: none;
      width: 100%;
    }

    .genre-dropdown-panel {
      width: 100%;
      grid-template-columns: repeat(3, 1fr);
    }

    /* ARTISTS GRID: one full-width card per row, same photo ratio as
       desktop — just scaled up to fill the phone screen. */
    .artists-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  @media (min-width: 500px) and (max-width: 850px) {
    /* General tablet shrink — matches the other pages' mobile header */
    .artists-hero {
      min-height: 38vh;
      align-items: center;
    }

    .artists-hero-content {
      text-align: center;
    }

    .year-switcher {
      justify-content: center;
    }
  }
</style>
